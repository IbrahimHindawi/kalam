{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-clang-debug",
      "displayName": "Windows clang-cl Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KALAM_BUILD_EDITOR": "OFF",
        "KALAM_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC-compatible cl Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KALAM_BUILD_EDITOR": "OFF",
        "KALAM_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-clang-editor-debug",
      "displayName": "Windows clang-cl Debug with editor",
      "inherits": "windows-clang-debug",
      "binaryDir": "${sourceDir}/build/windows-clang-editor-debug",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{KALAM_QT_PREFIX}",
        "KALAM_BUILD_EDITOR": "ON"
      },
      "environment": {
        "PATH": "$env{KALAM_QT_PREFIX}/bin;$penv{PATH}",
        "QT_PLUGIN_PATH": "$env{KALAM_QT_PREFIX}/plugins"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-clang-editor-debug",
      "configurePreset": "windows-clang-editor-debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-editor-debug",
      "configurePreset": "windows-clang-editor-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
